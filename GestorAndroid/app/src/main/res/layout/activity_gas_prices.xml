<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="16dp"
    tools:context=".ui.prices.GasPricesActivity">

    <!-- Título principal -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Consultar precios"
        android:layout_marginBottom="40dp"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Primera fila: TextView2 y Spinner1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="Zona"
            android:gravity="center" />

        <Spinner
            android:id="@+id/zoneSpinner"
            android:layout_width="0dp"
            android:layout_height="41dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:entries="@array/zone_array"/>
    </LinearLayout>

    <!-- Segunda fila: TextView3 y Spinner2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="40dp">

        <TextView
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="Tipo"
            android:gravity="center" />

        <Spinner
            android:id="@+id/typeSpinner"
            android:layout_width="0dp"
            android:layout_height="41dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:entries="@array/type_array"/>
    </LinearLayout>

    <!-- Tercera fila: TextView y EditText -->

    <!-- Botón centrado -->
    <Button
        android:id="@+id/button"
        android:layout_width="191dp"
        android:layout_height="51dp"
        android:text="Button"
        android:layout_marginBottom="40dp" />

    <!-- Espaciador que crece para empujar el último TextView abajo -->

    <!-- TextView final -->
    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />
</LinearLayout>